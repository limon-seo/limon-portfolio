---
import Layout from '../layouts/Layout.astro';
import Web from '../components/Web.astro';

const year = new Date().getFullYear();
---
<Layout>
  <!-- ===== Preloader ===== -->
  <div class="preloader" id="preloader">
    <Web class="preloader__web" spokes={10} rings={6} />
    <div class="preloader__spider">
      <svg class="spider-icon" viewBox="0 0 100 100"><use href="#spider" /></svg>
    </div>
    <p class="preloader__text">THWIP!</p>
  </div>

  <!-- ===== Reusable SVG symbols ===== -->
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <symbol id="spider" viewBox="0 0 100 100">
      <g fill="none" stroke="currentColor" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M44 38 L34 22 L26 6" />
        <path d="M42 45 L24 36 L8 34" />
        <path d="M42 56 L24 64 L10 74" />
        <path d="M44 63 L34 78 L28 96" />
        <path d="M56 38 L66 22 L74 6" />
        <path d="M58 45 L76 36 L92 34" />
        <path d="M58 56 L76 64 L90 74" />
        <path d="M56 63 L66 78 L72 96" />
      </g>
      <ellipse cx="50" cy="36" rx="8" ry="9" fill="currentColor" />
      <path d="M50 44 C62 44 63 58 60 68 C58 76 54 82 50 84 C46 82 42 76 40 68 C37 58 38 44 50 44Z" fill="currentColor" />
    </symbol>
  </svg>

  <!-- ===== Cursor ===== -->
  <div class="cursor" id="cursor"><span></span></div>

  <!-- ===== Scroll spider ===== -->
  <div class="scroll-thread" aria-hidden="true">
    <div class="scroll-thread__line" id="threadLine"></div>
    <svg class="scroll-thread__spider spider-icon" id="threadSpider" viewBox="0 0 100 100"><use href="#spider" /></svg>
  </div>

  <!-- ===== Header ===== -->
  <header class="header" id="header">
    <a href="#home" class="logo" aria-label="MD. Shafiqul Islam Limon home">
      <svg class="spider-icon" viewBox="0 0 100 100"><use href="#spider" /></svg>
      <span>LIMON<em>.seo</em></span>
    </a>
    <nav class="nav" id="nav">
      <a href="#about" class="nav__link">About</a>
      <a href="#experience" class="nav__link">Missions</a>
      <a href="#results" class="nav__link">Results</a>
      <a href="#skills" class="nav__link">Powers</a>
      <a href="#education" class="nav__link">Origin</a>
      <a href="#contact" class="nav__link nav__cta">Web Signal</a>
    </nav>
    <button class="burger" id="burger" aria-label="Toggle menu"><span></span><span></span><span></span></button>
  </header>

  <main>
    <!-- ===== Hero ===== -->
    <section class="hero" id="home">
      <Web class="hero__web hero__web--tl" spokes={12} rings={7} />
      <Web class="hero__web hero__web--br" spokes={12} rings={7} />
      <div class="halftone"></div>

      <div class="hanging-spider" id="hangingSpider">
        <div class="hanging-spider__thread"></div>
        <svg class="spider-icon" viewBox="0 0 100 100"><use href="#spider" /></svg>
      </div>

      <div class="hero__content container">
        <div class="hero__text">
          <p class="hero__tag"><i class="fa-solid fa-location-dot"></i> Your friendly neighborhood AI SEO from Dhaka</p>
          <h1 class="hero__title">
            <span class="line"><span class="word">MD. SHAFIQUL</span></span>
            <span class="line"><span class="word word--big">ISLAM <b>LIMON</b></span></span>
          </h1>
          <p class="hero__role">
            <span class="hero__role-label">Powers:</span>
            <span class="typed" id="typed" aria-hidden="true">SEO Specialist</span><span class="caret" aria-hidden="true">|</span>
            <span class="sr-only">SEO Specialist, Technical SEO Auditor, Schema Markup Builder, Core Web Vitals Fixer, Organic Growth Strategist</span>
          </p>
          <p class="hero__desc">
            Swinging websites up the SERPs with technical audits, structured data and organic strategies that
            turn impressions into real traffic, conversions and brand visibility.
          </p>
          <div class="hero__btns">
            <a href="#contact" class="btn btn--red"><i class="fa-solid fa-spider"></i> Hire Me</a>
            <a href="#results" class="btn btn--ghost"><i class="fa-solid fa-chart-line"></i> See Results</a>
          </div>
          <div class="hero__social">
            <a href="https://bd.linkedin.com/in/md-shafiqul-islam-limon" aria-label="LinkedIn" target="_blank" rel="noopener noreferrer"><i class="fa-brands fa-linkedin-in"></i></a>
            <a href="mailto:Shafiqul.limon@outlook.com" aria-label="Email"><i class="fa-solid fa-envelope"></i></a>
            <a href="tel:+8801861477113" aria-label="Phone"><i class="fa-solid fa-phone"></i></a>
            <a href="#contact" aria-label="Location"><i class="fa-solid fa-map-pin"></i></a>
          </div>
        </div>

        <div class="hero__visual">
          <div class="emblem">
            <Web class="emblem__web" spokes={14} rings={8} />
            <div class="emblem__ring"></div>
            <div class="emblem__core">
              <svg class="spider-icon" viewBox="0 0 100 100"><use href="#spider" /></svg>
            </div>
            <div class="bubble bubble--1">294K<small>Clicks</small></div>
            <div class="bubble bubble--2">DR 48</div>
            <div class="bubble bubble--3">1.63M<small>Impressions</small></div>
          </div>
        </div>
      </div>

      <a href="#about" class="scroll-hint"><span>Scroll</span><i class="fa-solid fa-angles-down"></i></a>
    </section>

    <!-- ===== Marquee ===== -->
    <div class="marquee">
      <div class="marquee__track">
        <span>Technical SEO</span><i class="fa-solid fa-spider"></i>
        <span>Schema Markup</span><i class="fa-solid fa-spider"></i>
        <span>Core Web Vitals</span><i class="fa-solid fa-spider"></i>
        <span>Keyword Research</span><i class="fa-solid fa-spider"></i>
        <span>Link Building</span><i class="fa-solid fa-spider"></i>
        <span>Content Briefs</span><i class="fa-solid fa-spider"></i>
        <span>Technical SEO</span><i class="fa-solid fa-spider"></i>
        <span>Schema Markup</span><i class="fa-solid fa-spider"></i>
        <span>Core Web Vitals</span><i class="fa-solid fa-spider"></i>
        <span>Keyword Research</span><i class="fa-solid fa-spider"></i>
        <span>Link Building</span><i class="fa-solid fa-spider"></i>
        <span>Content Briefs</span><i class="fa-solid fa-spider"></i>
      </div>
    </div>

    <!-- ===== About ===== -->
    <section class="section about" id="about">
      <div class="container">
        <div class="section__head reveal">
          <span class="section__kicker">#01 — Secret Identity</span>
          <h2 class="section__title">About <span>Me</span></h2>
        </div>

        <div class="about__grid">
          <div class="comic-panel about__panel reveal">
            <span class="caption">Meanwhile, in Dhaka...</span>
            <p>
              Results-driven <strong>AI SEO Specialist</strong> with <strong>3+ years</strong> of experience in digital
              marketing and organic growth strategies. Skilled in leading SEO campaigns, technical audits, and team
              collaboration to deliver measurable improvements in traffic, conversions, and brand visibility.
            </p>
            <p>
              Now seeking to leverage that expertise as an <strong>SEO Team Lead</strong> to drive scalable
              e-commerce growth.
            </p>
            <div class="sfx">POW!</div>
          </div>

          <div class="about__cards">
            <div class="mini-card reveal">
              <i class="fa-solid fa-user-secret"></i>
              <h4>Name</h4>
              <p>MD. Shafiqul Islam (Limon)</p>
            </div>
            <div class="mini-card reveal">
              <i class="fa-solid fa-briefcase"></i>
              <h4>Role</h4>
              <p>Digital Marketing Executive</p>
            </div>
            <div class="mini-card reveal">
              <i class="fa-solid fa-city"></i>
              <h4>Base</h4>
              <p>Dhaka, Bangladesh</p>
            </div>
            <div class="mini-card reveal">
              <i class="fa-solid fa-language"></i>
              <h4>Languages</h4>
              <p>Bangla (Native) · English (Fluent)</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== Experience ===== -->
    <section class="section experience" id="experience">
      <div class="halftone halftone--dark"></div>
      <div class="container">
        <div class="section__head reveal">
          <span class="section__kicker">#02 — Mission Log</span>
          <h2 class="section__title">Work <span>Experience</span></h2>
        </div>

        <div class="timeline">
          <div class="timeline__line"><div class="timeline__fill" id="timelineFill"></div></div>

          <article class="mission reveal-side">
            <div class="mission__dot"><i class="fa-solid fa-bolt"></i></div>
            <div class="mission__card">
              <div class="mission__top">
                <span class="badge badge--live"><i class="fa-solid fa-circle"></i> Current Mission</span>
                <span class="mission__date">July 2024 – Present</span>
              </div>
              <h3>Digital Marketing Executive</h3>
              <p class="mission__org"><i class="fa-solid fa-building"></i> Codeware Limited · Dhaka, Bangladesh</p>
              <ul>
                <li>Leading SEO campaigns for transport tech and ERP platforms.</li>
                <li>Conducting technical SEO audits, resolving crawl/indexing issues, and optimizing Core Web Vitals.</li>
                <li>Implementing structured data (schema, FAQ, product, breadcrumb) for improved SERP visibility.</li>
                <li>Managing keyword research, content briefs, and internal linking strategies.</li>
                <li>Achieved measurable growth on <strong>BusBora</strong>: 294K clicks, 1.63M impressions (July 2026), steady CTR growth and DR improved to 48.</li>
              </ul>
            </div>
          </article>

          <article class="mission reveal-side">
            <div class="mission__dot"><i class="fa-solid fa-shield-halved"></i></div>
            <div class="mission__card">
              <div class="mission__top">
                <span class="badge">Mission Complete</span>
                <span class="mission__date">Feb 2023 – June 2024</span>
              </div>
              <h3>SEO Executive</h3>
              <p class="mission__org"><i class="fa-solid fa-building"></i> Intellec IT LLC · Dhaka, Bangladesh</p>
              <ul>
                <li>Executed on-page and off-page SEO strategies, including backlink building and outreach.</li>
                <li>Optimized metadata, headings, and site architecture for improved rankings.</li>
                <li>Monitored performance using GA4, GSC, Ahrefs, and Semrush.</li>
                <li>Delivered consistent traffic growth and improved keyword visibility.</li>
              </ul>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- ===== Results ===== -->
    <section class="section results" id="results">
      <Web class="results__web" spokes={16} rings={9} />
      <div class="container">
        <div class="section__head reveal">
          <span class="section__kicker">#03 — Case File: BusBora</span>
          <h2 class="section__title">Hero <span>Stats</span></h2>
        </div>

        <div class="stats">
          <div class="stat reveal">
            <i class="fa-solid fa-computer-mouse"></i>
            <div class="stat__num"><span class="counter" data-to="294" data-dec="0">294</span>K</div>
            <p>Organic Clicks</p>
          </div>
          <div class="stat reveal">
            <i class="fa-solid fa-eye"></i>
            <div class="stat__num"><span class="counter" data-to="1.63" data-dec="2">1.63</span>M</div>
            <p>Impressions (July 2026)</p>
          </div>
          <div class="stat reveal">
            <i class="fa-solid fa-link"></i>
            <div class="stat__num">DR <span class="counter" data-to="48" data-dec="0">48</span></div>
            <p>Domain Rating</p>
          </div>
          <div class="stat reveal">
            <i class="fa-solid fa-hourglass-half"></i>
            <div class="stat__num"><span class="counter" data-to="3" data-dec="0">3</span>+</div>
            <p>Years of Experience</p>
          </div>
        </div>

        <div class="comic-strip reveal">
          <div class="comic-strip__item"><span>1</span>Technical Audit</div>
          <i class="fa-solid fa-arrow-right"></i>
          <div class="comic-strip__item"><span>2</span>Fix Crawl &amp; Index</div>
          <i class="fa-solid fa-arrow-right"></i>
          <div class="comic-strip__item"><span>3</span>Schema &amp; Content</div>
          <i class="fa-solid fa-arrow-right"></i>
          <div class="comic-strip__item comic-strip__item--win"><span>4</span>Traffic Growth!</div>
        </div>
      </div>
    </section>

    <!-- ===== Skills ===== -->
    <section class="section skills" id="skills">
      <div class="halftone halftone--dark"></div>
      <div class="container">
        <div class="section__head reveal">
          <span class="section__kicker">#04 — Spider Powers</span>
          <h2 class="section__title">Skills &amp; <span>Tools</span></h2>
        </div>

        <div class="skills__grid">
          <div class="power reveal">
            <div class="power__icon"><i class="fa-solid fa-toolbox"></i></div>
            <h3>SEO Tools</h3>
            <div class="chips">
              <span>Ahrefs</span><span>Semrush</span><span>GA4</span><span>GSC</span><span>Screaming Frog</span>
              <span>Microsoft Clarity</span><span>Moz Pro</span><span>MarketMuse</span><span>Keyword Planner</span>
            </div>
          </div>
          <div class="power reveal">
            <div class="power__icon"><i class="fa-solid fa-code"></i></div>
            <h3>Technical SEO</h3>
            <div class="chips">
              <span>HTML</span><span>CSS Basics</span><span>Schema Markup</span>
              <span>Core Web Vitals</span><span>Site Speed</span>
            </div>
          </div>
          <div class="power reveal">
            <div class="power__icon"><i class="fa-solid fa-pen-nib"></i></div>
            <h3>Content &amp; Analytics</h3>
            <div class="chips">
              <span>Keyword Research</span><span>Content Briefs</span><span>Internal Linking</span>
              <span>CTR Optimization</span><span>Reporting</span>
            </div>
          </div>
          <div class="power reveal">
            <div class="power__icon"><i class="fa-solid fa-crosshairs"></i></div>
            <h3>Competitor Analysis</h3>
            <div class="chips">
              <span>Backlink Gap</span><span>Keyword Gap</span><span>Content Gap</span>
            </div>
          </div>
          <div class="power reveal">
            <div class="power__icon"><i class="fa-solid fa-laptop-file"></i></div>
            <h3>Other</h3>
            <div class="chips">
              <span>MS Office Suite</span><span>WPS</span><span>English Communication</span><span>Bangla Communication</span>
            </div>
          </div>
          <div class="power power--quote reveal">
            <p>"With great rankings comes great responsibility."</p>
            <span>— Every SEO, probably</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== Education & Certifications ===== -->
    <section class="section education" id="education">
      <div class="container">
        <div class="section__head reveal">
          <span class="section__kicker">#05 — Origin Story</span>
          <h2 class="section__title">Education &amp; <span>Training</span></h2>
        </div>

        <div class="edu__grid">
          <div class="edu__col">
            <h3 class="edu__heading"><i class="fa-solid fa-graduation-cap"></i> Education</h3>
            <div class="edu-card reveal">
              <span class="edu-card__year">2022</span>
              <h4>BA (Hons) in English Literature</h4>
              <p>Habibullah Bahar University College, Dhaka</p>
            </div>
            <div class="edu-card reveal">
              <span class="edu-card__year">2016</span>
              <h4>H.S.C in Business Studies</h4>
              <p>Ideal Commerce College, Dhaka Board</p>
            </div>
            <div class="edu-card reveal">
              <span class="edu-card__year">2014</span>
              <h4>S.S.C in Business Studies</h4>
              <p>Nawabpur Govt. High School, Dhaka Board</p>
            </div>
          </div>

          <div class="edu__col">
            <h3 class="edu__heading"><i class="fa-solid fa-certificate"></i> Certifications</h3>
            <div class="edu-card edu-card--cert reveal">
              <span class="edu-card__year">24 Mar 2022</span>
              <h4>The Fundamentals of Digital Marketing</h4>
              <p><i class="fa-brands fa-google"></i> Google Digital Garage</p>
            </div>
            <div class="edu-card edu-card--cert reveal">
              <span class="edu-card__year">Apr – Oct 2021</span>
              <h4>Digital Marketing Training</h4>
              <p>Creative IT Institute</p>
            </div>
            <div class="lang reveal">
              <h3 class="edu__heading"><i class="fa-solid fa-comments"></i> Languages</h3>
              <div class="lang__row"><span>Bangla</span><div class="lang__bar"><i data-w="100" style="width:100%"></i></div><em>Native</em></div>
              <div class="lang__row"><span>English</span><div class="lang__bar"><i data-w="85" style="width:85%"></i></div><em>Fluent</em></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== Contact ===== -->
    <section class="section contact" id="contact">
      <Web class="contact__web" spokes={14} rings={8} />
      <div class="halftone"></div>
      <div class="container">
        <div class="contact__box reveal">
          <span class="section__kicker">#06 — Send the Web Signal</span>
          <h2 class="contact__title">Need a hero for your <span>rankings?</span></h2>
          <p>Open to SEO Team Lead roles and growth projects. Drop a line and I'll swing by.</p>

          <div class="contact__cards">
            <a class="contact-card" href="mailto:Shafiqul.limon@outlook.com">
              <i class="fa-solid fa-envelope"></i>
              <span>Email</span>
              <strong>Shafiqul.limon@outlook.com</strong>
            </a>
            <a class="contact-card" href="tel:+8801861477113">
              <i class="fa-solid fa-phone-volume"></i>
              <span>Phone</span>
              <strong>+880 1861-477113</strong>
            </a>
            <div class="contact-card">
              <i class="fa-solid fa-location-crosshairs"></i>
              <span>Location</span>
              <strong>Dhaka, Bangladesh</strong>
            </div>
          </div>

          <a href="mailto:Shafiqul.limon@outlook.com" class="btn btn--red btn--big"><i class="fa-solid fa-paper-plane"></i> Let's Work Together</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <p>© <span id="year">{year}</span> MD. Shafiqul Islam (Limon) · Crafted with <i class="fa-solid fa-heart"></i> &amp; webs</p>
  </footer>
</Layout>
